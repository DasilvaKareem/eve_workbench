<style>
  .panel { width: 400; flex-direction: column; padding-top: 14; padding-right: 16; padding-bottom: 14; padding-left: 16; gap: 8; background-color: #151d21; border-color: #60756a; border-width: 1; border-radius: 12; }
  .title { width: 244; color: #d6f29a; font-size: 14; height: 38; background-color: #25332e; border-radius: 6; cursor: pointer; }
  .text { color: #f3f3ee; font-size: 13; line-height: 1.35; height: 150; }
  .chart { width: 368; height: 180; }
  .status { color: #b6c7bd; font-size: 10; height: 28; }
  .row { flex-direction: row; gap: 8; }
  .button { width: 116; height: 36; align-items: center; justify-content: center; background-color: #29352f; color: #e1efd7; font-size: 11; border-color: #60756a; border-width: 1; border-radius: 6; cursor: pointer; }
  .page { width: 116; height: 36; justify-content: center; align-items: center; color: #b6c7bd; font-size: 11; }
</style>
<div class="panel">
  <div class="row"><div id="eve-generated-title" class="title">Panel</div><button id="eve-generated-hide" class="button">Close</button></div>
  <div id="eve-generated-text" class="text">Ask Eve to show a comparison, dashboard, or chart.</div>
  <img id="eve-generated-chart" class="chart" style="display: none" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1104'%20height='540'%3E%3Crect%20width='1104'%20height='540'%20fill='%23151d21'/%3E%3C/svg%3E" />
  <div id="eve-generated-status" class="status">Your generated panels appear here.</div>
  <div id="eve-generated-pages" class="row">
    <button id="eve-generated-previous" class="button">Previous page</button>
    <div id="eve-generated-page" class="page">1 / 1</div>
    <button id="eve-generated-next" class="button">Next page</button>
  </div>
  <div id="eve-generated-actions" class="row" style="display: none">
    <button id="eve-generated-action-0" class="button"><span id="eve-generated-action-label-0">Follow up</span></button>
    <button id="eve-generated-action-1" class="button"><span id="eve-generated-action-label-1">Follow up</span></button>
    <button id="eve-generated-action-2" class="button"><span id="eve-generated-action-label-2">Follow up</span></button>
  </div>
  <div id="eve-generated-switcher" class="row">
    <button id="eve-generated-panel-previous" class="button">Previous panel</button>
    <button id="eve-generated-panel-next" class="button">Next panel</button>
  </div>
  <div id="eve-generated-hint" class="status">Drag the title to move / two pointers to resize</div>
</div>
