<style>
  .console { flex-direction: column; width: 360; padding-top: 12; padding-right: 12; padding-bottom: 12; padding-left: 12; background-color: #15201c; border-color: #829582; border-width: 1; border-radius: 14; gap: 8; }
  .row { flex-direction: row; gap: 8; align-items: center; justify-content: space-between; }
  .heading { color: #d6f29a; font-size: 14; height: 20; }
  .handle { width: 240; height: 38; flex-direction: column; justify-content: center; padding-left: 6; padding-right: 6; background-color: #25332e; border-color: #60756a; border-width: 1; border-radius: 6; cursor: pointer; }
  .status { color: #bac9b9; font-size: 10; height: 16; }
  .reply { flex-direction: column; }
  .response { color: #f5f5ee; font-size: 12; line-height: 1.35; height: 112; }
  .field { width: 336; height: 65; font-size: 17; color: #f5f5ee; background-color: #223028; border-color: #94aa8e; border-width: 1; border-radius: 8; padding-top: 10; padding-right: 10; padding-bottom: 10; padding-left: 10; }
  .button { height: 32; width: 82; align-items: center; justify-content: center; background-color: #2c3a30; color: #f5f5ee; border-color: #60755d; border-width: 1; border-radius: 8; font-size: 12; cursor: pointer; }
  .send { background-color: #d6f29a; color: #192519; }
  .small { width: 62; height: 25; font-size: 10; }
  .page { width: 176; height: 34; align-items: center; justify-content: center; color: #d6f29a; font-size: 9; background-color: #25332e; border-color: #60756a; border-width: 1; border-radius: 6; cursor: pointer; }
  .hint { color: #a5b6a2; font-size: 8; height: 16; }
</style>
<div class="console">
  <div class="row"><div id="eve-xr-handle" class="handle"><div class="heading">Eve / pinch title to move</div></div><button id="eve-xr-exit" class="button small">Exit XR</button></div>
  <div id="eve-xr-reply" class="reply" style="display: none"><div id="eve-xr-response" class="response"></div></div>
  <div id="eve-xr-pages" class="row" style="display: none"><button id="eve-xr-previous" class="button small">Previous</button><div id="eve-xr-page" class="page"></div><button id="eve-xr-next-page" class="button small">Next</button></div>
  <textarea id="eve-xr-prompt" class="field" placeholder="Talk or type" />
  <div class="row"><div id="eve-xr-status" class="status">Connecting...</div><button id="eve-xr-mic" class="button"><span id="eve-xr-mic-label">Talk / type</span></button><button id="eve-xr-send" class="button send"><span id="eve-xr-send-label">Send</span></button></div>
  <div id="eve-xr-gesture-hint" class="hint">Thumb + index: pinch title to move / Two hands: resize</div>
</div>
