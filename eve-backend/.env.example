# Required for requests from the frontend proxy to a deployed agent.
# Use a long random value; match EVE_API_KEY on the frontend deployment.
EVE_API_KEY=
# Local model access through Vercel AI Gateway. On Vercel, Eve uses project OIDC.
AI_GATEWAY_API_KEY=
# Optional: use real Vercel Sandbox for browser tools during local development.
# Requires Vercel Sandbox credentials (or a supported Vercel OIDC environment).
# EVE_BROWSER_SANDBOX=vercel
