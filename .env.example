# Frontend / proxy environment. Never prefix secrets with VITE_.
# Local backend: run `npm run dev` in eve-backend.
EVE_AGENT_URL=http://127.0.0.1:2000
# Same value as EVE_API_KEY in the Eve backend; required for deployed backend calls.
EVE_API_KEY=
# Required in production, at least 16 characters; unlocks this personal workspace.
WORKBENCH_ACCESS_KEY=
